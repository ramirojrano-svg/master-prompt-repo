// prisma/schema.prisma — fuente de verdad de los MODELOS (§3.5, unificado a operadorId).
//
// Crece por fase (§16). Hoy contiene el núcleo del paso 2: tenant + espacio + inquilino
// + Ocupacion. Auth (Usuario/UsuarioOperador), plata (Reserva/Asiento/Liquidacion),
// Tarifa y Membresia entran en sus fases con sus migraciones.
//
// ⚠️ Lo que Prisma NO expresa vive en SQL a mano (prisma/migrations/0001_ocupacion_exclusion):
// la extensión btree_gist, las columnas generadas `rango`/`ocupa`, y los dos EXCLUDE.
// `prisma db push` los BORRA en silencio (lección §9) — usar `prisma migrate`, nunca push.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (modo transacción, puerto 6543 en Supabase)
  directUrl = env("DIRECT_URL") // conexión directa, solo para migraciones
}

// ─────────────────────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────────────────────
model Operador {
  id       String   @id @default(cuid())
  nombre   String
  pais     String   @default("AR") // define moneda, IVA y textos legales (§7)
  moneda   String   @default("ARS")
  slug     String   @unique
  creadoEl DateTime @default(now()) @db.Timestamptz(6)

  sedes         Sede[]
  salas         Sala[]
  inquilinos    Inquilino[]
  ocupaciones   Ocupacion[]
  esperas       EsperaSlot[]
  bolsaAsientos BolsaAsiento[]
  usuarios      UsuarioOperador[]
  asientos      Asiento[]
  liquidaciones Liquidacion[]
  membresias    Membresia[]
  tarifas       Tarifa[]
  gastos        Gasto[]
}

// ─────────────────────────────────────────────────────────────
// TARIFA (§3.5) — precio de la hora de sala. Se resuelve por ESPECIFICIDAD: la que apunta a un
// profesional concreto gana sobre la de una sala, y esa sobre la general del centro.
// El precio NO se edita: se cierra la tarifa vigente (vigenteHasta) y se crea otra. Así, cambiar
// el precio mañana no reescribe lo que ya se reservó ni lo que ya se facturó (§8.8).
// ─────────────────────────────────────────────────────────────
model Tarifa {
  id             String    @id @default(cuid())
  operadorId     String
  salaId         String? // null = todas las salas
  inquilinoId    String? // null = todos los profesionales
  nombre         String
  precioHoraCent BigInt // centavos por hora. Se prorratea por minutos al cotizar.
  vigenteDesde   DateTime  @default(now()) @db.Timestamptz(6)
  vigenteHasta   DateTime? @db.Timestamptz(6) // null = vigente hoy
  creadoEl       DateTime  @default(now()) @db.Timestamptz(6)

  operador Operador @relation(fields: [operadorId], references: [id], onDelete: Cascade)

  @@index([operadorId, vigenteHasta])
  @@index([operadorId, inquilinoId])
  @@index([operadorId, salaId])
}

// ─────────────────────────────────────────────────────────────
// USUARIOS Y ROLES (§3.5 / §6.2)
// Un usuario puede trabajar en varios operadores (el psicólogo que alquila en 3 centros tiene
// UNA identidad y UNA contraseña). El rol vive en la RELACIÓN, nunca en el usuario, y se relee
// fresco de la DB en cada request (§6.2).
// ─────────────────────────────────────────────────────────────
model Usuario {
  id            String   @id @default(cuid())
  email         String   @unique
  nombre        String
  telefono      String? // canonicalizado en el borde de entrada (regla 17)
  passwordHash  String? // Credentials (Auth.js); null hasta que se setea
  sessionVersion Int     @default(0) // se incrementa en baja/cambio de rol crítico (§9)
  creadoEl      DateTime @default(now()) @db.Timestamptz(6)

  operadores UsuarioOperador[]
}

enum Rol {
  owner // dueño del centro
  gestor // encargado/administradora
  recepcion // mostrador
  inquilino_titular // el profesional que alquila
  inquilino_staff // su secretaria (todo menos plata)
  soporte_plataforma // nosotros, solo lectura con consentimiento
}

model UsuarioOperador {
  usuarioId   String
  operadorId  String
  rol         Rol
  inquilinoId String? // si rol = inquilino_*, a qué inquilino corresponde
  activo      Boolean @default(true)

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  operador  Operador   @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  // FK compuesta (operadorId, inquilinoId) NoAction: Postgres rechaza mezclar tenants (§3.6).
  inquilino Inquilino? @relation(fields: [operadorId, inquilinoId], references: [operadorId, id], onDelete: NoAction)

  @@id([usuarioId, operadorId])
  @@unique([operadorId, inquilinoId]) // 1:1 con Inquilino sobre la FK compuesta; un inquilino, un acceso
  @@index([operadorId, rol])
}

// ─────────────────────────────────────────────────────────────
// ESPACIO
// ─────────────────────────────────────────────────────────────
model Sede {
  id          String  @id @default(cuid())
  operadorId  String
  nombre      String
  direccion   String  @default("")
  zonaHoraria String // OBLIGATORIO (regla dura §14.4). Se deriva del país en el alta, sin default de esquema.
  activa      Boolean @default(true)

  operador Operador @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  salas    Sala[]

  @@unique([operadorId, id]) // habilita las FK compuestas (§3.6)
  @@index([operadorId])
}

model Sala {
  id          String    @id @default(cuid())
  operadorId  String
  sedeId      String
  nombre      String
  color       String    @default("#2f6fe0")
  orden       Int       @default(0) // el operador arrastra las columnas: el pasillo no es alfabético (§6.4)
  equipamiento String[] @default([])
  horarioJson Json? // apertura semanal; se sanea con parseHorarios (§4.4). null => default
  bufferMin   Int       @default(15) @db.SmallInt // limpieza entre inquilinos distintos (§4.6)
  activa      Boolean   @default(true) // baja lógica: NUNCA borrar una sala con historia
  archivadaEl DateTime? @db.Timestamptz(6)

  operador    Operador    @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  // NoAction (no SetNull): con FK compuesta y operadorId NOT NULL, SetNull falla con 23502 (§3.6).
  sede        Sede        @relation(fields: [operadorId, sedeId], references: [operadorId, id], onDelete: NoAction)
  ocupaciones Ocupacion[]

  @@unique([operadorId, id])
  @@index([operadorId, sedeId, activa])
}

// ─────────────────────────────────────────────────────────────
// INQUILINO
// ─────────────────────────────────────────────────────────────
model Inquilino {
  id         String          @id @default(cuid())
  operadorId String
  nombre     String
  estado     EstadoInquilino @default(activo)
  // Quién ABONA por este profesional, cuando no es él mismo. Es TEXTO y no una relación a otro
  // inquilino a propósito: el que paga puede no alquilar en el centro (no tiene ficha), y la
  // deuda NO se muda — sigue siendo de quien usó la hora. Esto es un dato para facturar y cobrar,
  // no un cambio de titular de la cuenta: mover el saldo a otro rompería el suyo.
  pagador    String?

  operador    Operador    @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  ocupaciones Ocupacion[]
  usuario     UsuarioOperador?
  membresias  Membresia[]

  @@unique([operadorId, id])
  @@index([operadorId, estado])
}

// ─────────────────────────────────────────────────────────────
// MEMBRESÍA (§3.5) — plan mensual con cupo de horas. vigenteHasta es FECHA, no booleano
// (§9 regla 11): null o pasado => NO vigente (fail-closed). Se corre hacia adelante con cada
// cobro. membresiaVigente() (§4.12) es el ÚNICO predicado que la lee.
// ─────────────────────────────────────────────────────────────
model Membresia {
  id                  String    @id @default(cuid())
  operadorId          String
  inquilinoId         String
  nombre              String
  precioMensualCent   BigInt // centavos
  minutosIncluidos    Int       @default(0) // 0 = puro pago por uso
  precioExcedenteCent BigInt?
  salaExclusivaId     String?
  diaDeCobro          Int       @default(1)
  estado              String    @default("activa") // activa | suspendida | baja
  vigenteDesde        DateTime  @db.Timestamptz(6)
  vigenteHasta        DateTime? @db.Timestamptz(6) // null/pasado = no vigente (fail-closed)
  cancelaAlFin        Boolean   @default(false)
  creadoEl            DateTime  @default(now()) @db.Timestamptz(6)

  operador  Operador  @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  inquilino Inquilino @relation(fields: [operadorId, inquilinoId], references: [operadorId, id], onDelete: NoAction)

  @@index([operadorId, inquilinoId, vigenteHasta])
}

enum EstadoInquilino {
  activo
  suspendido
  baja
}

// ─────────────────────────────────────────────────────────────
// TIEMPO — una sola tabla ocupa la sala (§4.8.2)
// ─────────────────────────────────────────────────────────────
enum TipoOcupacion {
  reserva
  hold
  bloqueo
  mantenimiento

  @@map("tipo_ocupacion")
}

enum EstadoOcupacion {
  solicitada
  confirmada
  en_curso
  usada
  no_show
  cancelada
  rechazada
  reubicada
  expirada

  @@map("estado_ocupacion")
}

model Ocupacion {
  id                 String          @id @default(cuid())
  operadorId         String
  sedeId             String? // NULL = bloqueo global (todo el operador)
  salaId             String? // NULL solo si tipo='bloqueo'
  inquilinoId        String? // NULL en bloqueo y mantenimiento
  tipo               TipoOcupacion
  estado             EstadoOcupacion @default(confirmada)
  inicio             DateTime        @db.Timestamptz(6) // SIEMPRE UTC (regla 2)
  fin                DateTime        @db.Timestamptz(6) // exclusivo: [inicio, fin)
  bufferMin          Int             @default(0) @db.SmallInt // ESTAMPADO al nacer (§4.6)
  tzSede             String // ESTAMPADO al nacer (§4.3.3)
  bloqueaProfesional Boolean         @default(true) // estampado desde la config del centro
  serieId            String?
  reemplazaAId       String?
  motivo             String? // bloqueo/mantenimiento/reubicación/no-show
  notaInterna        String? // libre, del operador; nunca datos de paciente (§3.3)
  // SNAPSHOT comercial (§8.8): se estampa al NACER y ningún update posterior lo reescribe.
  // Cambiar la tarifa en enero no puede mover la liquidación de diciembre.
  tarifaId           String?
  precioHoraCent     BigInt? // el precio que regía cuando se creó
  importeCent        BigInt? // precioHora × minutos / 60, ya calculado y congelado
  expiraAt           DateTime?       @db.Timestamptz(6) // solo tipo='hold'
  creadoEl           DateTime        @default(now()) @db.Timestamptz(6)

  // Columnas GENERADAS `rango` (tstzrange '[)') y `ocupa` (estado IN (...)) y los dos
  // EXCLUDE viven en la migración SQL a mano, no acá: Prisma no los expresa.

  operador   Operador   @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  sala       Sala?      @relation(fields: [operadorId, salaId], references: [operadorId, id], onDelete: NoAction)
  inquilino  Inquilino? @relation(fields: [operadorId, inquilinoId], references: [operadorId, id], onDelete: NoAction)
  reemplazaA Ocupacion? @relation("Reubicacion", fields: [reemplazaAId], references: [id], onDelete: NoAction)
  reemplazos Ocupacion[] @relation("Reubicacion")

  @@index([operadorId, salaId, inicio])
  @@index([operadorId, inquilinoId, inicio])
  @@index([serieId])
}

// ─────────────────────────────────────────────────────────────
// LISTA DE ESPERA (§4.11)
// ─────────────────────────────────────────────────────────────
model EsperaSlot {
  id           String   @id @default(cuid())
  operadorId   String
  inquilinoId  String
  salaId       String? // null = cualquiera del centro
  fechaDesde   DateTime @db.Timestamptz(6)
  fechaHasta   DateTime @db.Timestamptz(6)
  franjaDesde  String? // 'HH:MM' hora local de la sede
  franjaHasta  String?
  vigenteHasta DateTime @db.Timestamptz(6)
  activo       Boolean  @default(true)
  pases        Int      @default(0) // tras 3 pases sin respuesta => inactivo
  creadoEl     DateTime @default(now()) @db.Timestamptz(6)

  operador Operador @relation(fields: [operadorId], references: [id], onDelete: Cascade)

  // el tope cuenta SOLO futuro: se filtra por fechaHasta >= ahora
  @@index([operadorId, activo, fechaHasta])
}

// ─────────────────────────────────────────────────────────────
// LIBRO DE MINUTOS (§5.2) — append-only. NUNCA se suma con la plata (Asiento).
// bolsa='mes' vence solo (el saldo filtra por periodo actual); bolsa='pack' no vence
// (periodo = '0000-00'). Cero crons de expiración.
// ─────────────────────────────────────────────────────────────
model BolsaAsiento {
  id          String   @id @default(cuid())
  operadorId  String
  inquilinoId String
  bolsa       String   @db.VarChar(8) // 'mes' | 'pack'
  minutos     Int // + alta, − consumo
  periodo     String   @db.VarChar(7) // 'YYYY-MM' en la tz del CENTRO, pasado por el caller
  origenId    String? // membresiaId o bonoId
  reservaId   String?
  clave       String // idempotente: '<concepto>:<id>[:<periodo>]'
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  operador Operador @relation(fields: [operadorId], references: [id], onDelete: Cascade)

  @@unique([operadorId, clave])
  @@index([operadorId, inquilinoId, bolsa, periodo])
}

// ─────────────────────────────────────────────────────────────
// LIBRO DE PLATA (§5.2) — append-only. NUNCA update, NUNCA delete: se compensa con un asiento
// de signo opuesto. saldo = SUM(montoCent) sobre cuenta='corriente'. saldo > 0 => deudor.
// Enteros en centavos (BigInt), jamás Float/number. Nunca se suma con BolsaAsiento (otro libro).
// ─────────────────────────────────────────────────────────────
enum CuentaTipo {
  corriente
  garantia
}

enum Concepto {
  // + (el inquilino DEBE)
  cargo_uso
  cargo_excedente
  cargo_membresia
  cargo_exclusividad
  cargo_bono
  penalidad_tardia
  penalidad_noshow
  ajuste_debito
  deposito_alta
  interes_mora
  // − (a favor del inquilino)
  pago
  pago_con_deposito
  nota_credito
  penalidad_revertida
  reintegro
  ajuste_credito
  deposito_devolucion
  deposito_ejecucion
}

/// Cómo entró la plata. Solo los dos medios que usa el centro: los dos dejan comprobante, así que
/// el asiento puede guardar la referencia y la conciliación contra el resumen bancario es directa.
enum MedioPago {
  mercado_pago
  transferencia
}

/// En qué se va la plata del espacio. Cerrado a propósito: con texto libre, "Luz", "luz" y "EDESUR"
/// terminan siendo tres categorías distintas y el mes deja de poder compararse contra el anterior.
enum RubroGasto {
  alquiler // el alquiler del inmueble, si el centro no es propio
  expensas
  servicios // luz, gas, agua, internet, teléfono
  limpieza
  mantenimiento // arreglos, pintura, plomería, service de equipos
  insumos // descartables, papelería, café
  sueldos // recepción y personal
  impuestos // ABL, ingresos brutos, tasas
  seguros
  marketing
  otros
}

/// Un gasto del espacio, del lado de AFUERA del libro de inquilinos.
///
/// No entra en Asiento a propósito. Ese libro es la cuenta corriente CONTRA CADA PROFESIONAL: todo
/// lo que tiene adentro suma o resta de lo que alguien debe. Un gasto de luz no lo debe nadie, y
/// meterlo ahí ensuciaría los saldos —que es justo lo que se cuidó al no mover la deuda a la
/// cuenta del pagador—. Son dos libros distintos porque responden dos preguntas distintas: uno
/// "quién me debe", el otro "cuánto me cuesta tener esto abierto".
model Gasto {
  id           String     @id @default(cuid())
  operadorId   String
  rubro        RubroGasto
  detalle      String     @db.VarChar(200)
  montoCent    BigInt
  moneda       String     @db.VarChar(3)
  periodo      String     @db.VarChar(7) // 'YYYY-MM' en la tz del CENTRO
  fecha        DateTime   @db.Timestamptz(6) // el día del gasto, no el de carga
  proveedor    String?    @db.VarChar(120)
  // Anular en vez de borrar, igual que un cobro: el mes que ya se miró tiene que seguir dando lo
  // mismo. `anuladoEl` null = vigente (fecha, no booleano — §9 regla 11).
  anuladoEl    DateTime?  @db.Timestamptz(6)
  anuladoPor   String?
  motivoAnulado String?   @db.VarChar(200)
  creadoPorUserId String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  operador Operador @relation(fields: [operadorId], references: [id], onDelete: Cascade)

  @@index([operadorId, periodo])
  @@index([operadorId, rubro, periodo])
}

model Asiento {
  id           String     @id @default(cuid())
  operadorId   String
  inquilinoId  String
  cuenta       CuentaTipo @default(corriente)
  concepto     Concepto
  montoCent    BigInt // centavos, con signo. + = debe, − = a favor.
  moneda       String     @db.VarChar(3)
  periodo      String     @db.VarChar(7) // 'YYYY-MM' en la tz del CENTRO, pasado por el caller
  fechaHecho   DateTime   @db.Timestamptz(6) // instante del hecho económico (no createdAt)
  clave        String // idempotente: '<concepto>:<idNatural>[:<periodo>]'
  reservaId       String?
  liquidacionId   String? // se sella al cerrar el período; después no se toca
  pagoId          String?
  // Solo en los asientos de cobro. `referencia` es el nº de operación del comprobante: es lo que
  // permite conciliar contra el resumen, y además vuelve idempotente la carga — dos veces el
  // mismo comprobante es el MISMO cobro, no dos (va dentro de `clave`).
  medio           MedioPago?
  referencia      String?
  revierteAId     String? // asiento original de una reversa
  motivo          String? // obligatorio en ajuste_*, deposito_ejecucion, nota_credito
  creadoPorUserId String? // null = sistema
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  operador Operador @relation(fields: [operadorId], references: [id], onDelete: Cascade)

  @@unique([operadorId, clave]) // anti doble-facturación real (los NULL no colisionan en PG)
  @@index([operadorId, inquilinoId, cuenta, fechaHecho])
  @@index([operadorId, periodo])
  @@index([operadorId, liquidacionId])
}

model Liquidacion {
  id           String    @id @default(cuid())
  operadorId   String
  inquilinoId  String
  periodo      String    @db.VarChar(7)
  numero       Int // correlativo POR OPERADOR, para el PDF interno
  estado       String // 'borrador' | 'emitida' | 'parcial' | 'pagada' | 'vencida' | 'anulada'
  // Congelados al emitir. NUNCA se recalculan leyendo los asientos de nuevo.
  subtotalCent BigInt
  netoCent     BigInt // estimación fiscal (§7)
  ivaCent      BigInt
  alicuota     Int // 0 | 105 | 210 (décimas de %) — congelada
  totalCent    BigInt
  venceEl      DateTime  @db.Timestamptz(6)
  emitidaAt    DateTime? @db.Timestamptz(6)
  // datos fiscales del receptor ESTAMPADOS al emitir, no leídos de la ficha
  receptorRazonSocial String
  receptorCuit        String?
  receptorCondIva     String
  facturaExternaTipo  String? // 'A' | 'B' | 'C' — cargado a mano por el operador
  facturaExternaNro   String?
  facturaExternaCae   String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  operador Operador @relation(fields: [operadorId], references: [id], onDelete: Cascade)

  @@unique([operadorId, inquilinoId, periodo]) // ← anti doble-facturación real
  @@unique([operadorId, numero])
}
