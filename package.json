{
  "name": "saas-alquiler-consultorios",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "acceso": "node scripts/acceso.mjs",
    "build": "next build",
    "db:esquema": "node scripts/esquema.mjs",
    "db:reset": "node scripts/esquema.mjs --reset",
    "dev": "next dev",
    "doctor": "node scripts/doctor.mjs",
    "humo": "node scripts/humo.mjs",
    "instalar": "npm run db:esquema && npm run seed && npm run doctor",
    "limpiar": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true});console.log('.next borrado: la proxima compilacion arranca de cero')\"",
    "postinstall": "prisma generate",
    "predev": "node scripts/entorno-limpio.mjs",
    "seed": "node prisma/seed.ts",
    "vaciar-agenda": "node scripts/vaciar-agenda.mjs",
  "test": "node --test \"src/**/*.test.ts\"",
    "test:db": "node --test --test-concurrency=1 \"tests/integracion/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "vercel-build": "node scripts/esquema.mjs && next build",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
    "typescript": "^5.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  }
}
