{
  "name": "saas-alquiler-consultorios",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "test:db": "node --test --test-concurrency=1 \"tests/integracion/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm test",
    "postinstall": "prisma generate",
    "build": "next build",
    "dev": "next dev",
    "seed": "node prisma/seed.ts",
    "humo": "node scripts/humo.mjs"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
    "typescript": "^5.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  }
}
