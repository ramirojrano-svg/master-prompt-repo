# Copiá a .env.local y completá. `npm run dev` no arranca sin DATABASE_URL y AUTH_SECRET.
DATABASE_URL="postgresql://postgres@127.0.0.1:55432/motor"
DIRECT_URL="postgresql://postgres@127.0.0.1:55432/motor"
AUTH_SECRET="generá uno con: openssl rand -base64 32"
# AUTH_URL="http://localhost:3000"

# El alta pública de centros (/alta) viene CERRADA. Prendela solo si querés que cualquiera pueda
# crearse un centro desde internet; en una instalación de un solo centro, dejala apagada.
# ALTA_ABIERTA="true"

# Los tests de integración hacen DROP SCHEMA: usan SU PROPIA base (nunca la de desarrollo).
# Por defecto es DATABASE_URL + "_test"; se puede fijar explícitamente:
# TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:55432/motor_test"

# Restablecer contraseña por mail. Sin NINGUNA de las dos vías configuradas, la pantalla "olvidé
# mi contraseña" avisa que el envío no está configurado en vez de fingir que mandó algo.
#
# VÍA 1 — SMTP. No necesita dominio propio: el correo sale de una casilla que ya existe. Con Gmail,
# SMTP_PASS NO es la contraseña de la cuenta, es una "contraseña de aplicación" de 16 letras que se
# genera en la Cuenta de Google (requiere verificación en dos pasos).
# Sin EMAIL_FROM, el remitente es el propio SMTP_USER — que es lo que Gmail obliga igual.
# SMTP_USER="elcentro@gmail.com"
# SMTP_PASS="abcd efgh ijkl mnop"
# SMTP_HOST="smtp.gmail.com"   # default
# SMTP_PORT="587"              # default (465 = TLS directo)
#
# VÍA 2 — Resend. Necesita un dominio verificado en resend.com, y a cambio el mail sale de una
# dirección del centro. Si están las dos, gana esta.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="EMOAPP <no-responder@tudominio.com>"
